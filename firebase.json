{
  "functions": { "source": "functions" },
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "functions/**",
      "node_modules/**",
      ".firebase-cli-cache/**",
      ".git/**",
      ".agents/**",
      "epreem-fb6b6-firebase-adminsdk-fbsvc-8ff5a4f52a.json",
      ".env",
      ".env.example",
      "server.js",
      "render-server.js",
      "create-admin.js",
      "routes/**",
      "config/**",
      "database/**",
      "app/**"
    ],
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [{ "source": "/api/**", "function": "api" }]
  }
}
